{
	auto_https off
	admin off
}

# Static host for the VitePress build (./.vitepress/dist copied to /srv).
# Railway injects $PORT; default 8080 keeps Dokploy/local parity.
:{$PORT:8080} {

	root * /srv
	encode gzip zstd

	# Healthcheck for Railway / Dokploy / Uptime-Kuma.
	handle /health* {
		respond "ok" 200
	}

	# WordPress / exploit probes: tiny 404 body, no access log.
	# Returning the full index.html with 200 here only invites more scanning.
	@exploit_paths path /wordpress* /wp/* /wp-* /wp-json* /xmlrpc.php /xmlrpc* /.env* /.git* /cgi-bin* /*.php
	handle @exploit_paths {
		log_skip
		respond "Not found" 404
	}

	@exploit_query query rest_route=*
	handle @exploit_query {
		log_skip
		respond "Not found" 404
	}

	handle {
		try_files {path} {path}.html {path}/
		file_server
	}

	handle_errors {
		rewrite * /404.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	header /assets/* Cache-Control "public, max-age=31536000, immutable"
}
